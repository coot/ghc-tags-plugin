index-state: 2026-01-02T00:00:00Z

packages: ghc-tags-plugin
          ghc-tags-core
          ghc-tags-pipes
          ghc-tags-test

allow-newer: pipes-safe:base

package ghc-tags-core
  tests: True

if impl (ghc >= 9.14)
  allow-newer: *:base, *:template-haskell, *:containers, *:ghc-bignum, *:time

-- GHC 9.12 ships ghc-boot-th-9.12 which exports GHC.Boot.TH.Syntax.
-- ghc-lib-parser-9.14 also bundles that module, and ghc-lib-9.14.cabal
-- explicitly adds -package=ghc-boot-th for GHC < 9.14, making both visible
-- and causing an ambiguity error.  Pin ghc-lib to its 9.12.x series so both
-- packages agree on who owns the module.
if impl (ghc >= 9.12 && < 9.14)
  constraints: ghc-lib         ^>= 9.12,
               ghc-lib-parser  ^>= 9.12
